# Ne jamais exposer cette clé au navigateur : elle est uniquement utilisée par les routes API serveur.
RIOT_API_KEY=RGAPI-your-key-here

# EUW1 pour les joueurs EU West. La route régionale de Match-V5 est EUROPE.
RIOT_PLATFORM=EUW1
RIOT_REGIONAL_ROUTING=EUROPE

# Rythme prudent pour une clé Riot de développement (en millisecondes).
RIOT_REQUEST_INTERVAL_MS=1100

# PostgreSQL local ou variable DATABASE_URL référencée depuis le service PostgreSQL Railway.
# En production Railway, ne renseignez pas une URL publique : utilisez la référence interne DATABASE_URL.
DATABASE_URL=postgresql://postgres:password@localhost:5432/rift_room
